{
  "expo": {
    "name": "arsivinyo-memegy-rn",
    "slug": "arsivinyo-memegy-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/arsivinyo_memegy_1024.png",
    "scheme": "memegy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/arsivinyo_memegy_1024.png",
      "bundleIdentifier": "com.anonymous.arsivinyomemegyrn",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Memegy to access your photo library for downloaded videos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Memegy to save downloaded videos to your photo library.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "whatsapp"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/arsivinyo_memegy_1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.arsivinyomemegyrn"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/arsivinyo_memegy_512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/arsivinyo_memegy_2048_transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000"
          },
          "light": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-video",
      "expo-media-library"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "MemegyShareExtension",
                  "bundleIdentifier": "com.anonymous.arsivinyomemegyrn.share",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.anonymous.arsivinyomemegyrn"
                    ]
                  },
                  "infoPlist": {
                    "NSExtension": {
                      "NSExtensionPointIdentifier": "com.apple.share-services"
                    }
                  }
                },
                {
                  "targetName": "MemegyShareExtension",
                  "bundleIdentifier": "com.anonymous.arsivinyomemegyrn.share",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.anonymous.arsivinyomemegyrn"
                    ]
                  },
                  "infoPlist": {
                    "NSExtension": {
                      "NSExtensionPointIdentifier": "com.apple.share-services"
                    }
                  }
                }
              ]
            }
          }
        },
        "projectId": "92ab2c0e-7da0-44f6-a261-3a27857fe0e1"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/92ab2c0e-7da0-44f6-a261-3a27857fe0e1",
      "checkOnLaunch": "ALWAYS",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
