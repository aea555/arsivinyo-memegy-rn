{
  "expo": {
    "name": "arsivinyo-memegy-rn",
    "slug": "arsivinyo-memegy-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/arsivinyo_memegy_1024.png",
    "scheme": "memegy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/arsivinyo_memegy_1024.png",
      "bundleIdentifier": "com.anonymous.arsivinyomemegyrn",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Memegy to access your photo library for downloaded videos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Memegy to save downloaded videos to your photo library."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/arsivinyo_memegy_1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.arsivinyomemegyrn"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/arsivinyo_memegy_512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/arsivinyo_memegy_2048_transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-media-library"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
